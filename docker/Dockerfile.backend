FROM php:8.3-fpm

# Dependencias del sistema necesarias para extensiones PHP
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    zip \
    unzip \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip

# Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY . .

RUN composer install --no-interaction --optimize-autoloader

# Límites de subida (el archivo de referencia vive en docker/php.ini)
RUN printf 'upload_max_filesize = 110M\npost_max_size = 120M\n' \
    > /usr/local/etc/php/conf.d/uploads.ini

# Entrypoint: garantiza permisos de storage antes de arrancar PHP-FPM
# (el archivo de referencia vive en docker/entrypoint.sh)
RUN printf '#!/bin/sh\nchmod -R 777 /var/www/html/storage 2>/dev/null || true\nexec php-fpm\n' \
    > /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 9000

ENTRYPOINT ["entrypoint.sh"]